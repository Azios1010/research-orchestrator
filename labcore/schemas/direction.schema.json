{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "direction.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug", "title", "status", "question", "hypotheses", "data", "compute",
    "entrypoint", "outputs", "scorecard_map", "gates", "owner_notes"
  ],
  "properties": {
    "slug": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "$ref": "#/$defs/status" },
    "question": { "type": "string", "minLength": 1 },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "falsified_if"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "falsified_if": { "type": "string", "minLength": 1 }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "license", "access", "contains_patient_data"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "access": { "type": "string", "minLength": 1 },
        "contains_patient_data": { "type": "boolean" },
        "dataset_sources": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+(/[0-9]+)?$" }
        }
      }
    },
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["l1_gpu_hours_cap"],
      "properties": {
        "l1_gpu_hours_cap": { "type": "number", "exclusiveMinimum": 0 },
        "max_l1_rounds": { "type": "integer", "minimum": 1, "default": 2 }
      }
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "function"],
      "properties": {
        "module": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$" },
        "function": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relpath" }
    },
    "scorecard_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_subjects_requested", "n_subjects_usable", "metrics"],
      "properties": {
        "n_subjects_requested": { "$ref": "#/$defs/source" },
        "n_subjects_usable": { "$ref": "#/$defs/source" },
        "metrics": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\([A-Za-z0-9_]+(-[A-Za-z0-9_]+)?\\))?$"
          },
          "additionalProperties": { "$ref": "#/$defs/source" }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approval", "GO", "PARK"],
      "properties": {
        "approval": { "enum": ["DRAFT", "APPROVED"] },
        "GO": { "type": "string", "minLength": 1 },
        "PARK": { "type": "string", "minLength": 1 }
      }
    },
    "owner_notes": { "type": "string" }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "maxLength": 30 },
    "status": {
      "enum": ["IDEA", "SCAFFOLDED", "L0_PASS", "L1_RUNNING", "VERDICT", "GRADUATED", "ARCHIVED"]
    },
    "relpath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9_./-]+$"
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "path"],
          "properties": {
            "file": { "$ref": "#/$defs/relpath" },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "column"],
          "properties": {
            "file": { "$ref": "#/$defs/relpath" },
            "column": { "type": "string", "minLength": 1 },
            "where": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
            "agg": { "enum": ["mean", "median", "min", "max", "sum", "count"] }
          }
        }
      ]
    }
  }
}
